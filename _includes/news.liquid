{% comment %}
  Local override of al_folio_core's news.liquid. Changes from upstream:
    1. Dates render as '%b %Y' (Mon Year) instead of '%b %d, %Y'.
    2. Every entry is rendered, but entries past the limit start hidden and a
       button expands or collapses them in place (no navigation).
  Re-check this file against the theme on major upgrades.
{% endcomment %}
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news %}
          <tr
            {% if forloop.index0 >= news_limit %}
              class="news-extra" style="display: none"
            {% endif %}
          >
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if news_limit < news_size %}
      <div class="more-news mt-2">
        <button
          class="btn btn-outline-primary"
          type="button"
          data-news-toggle
          data-more="show older news"
          data-less="hide older news"
          aria-expanded="false"
        >
          show older news
        </button>
      </div>
      <script>
        document.querySelectorAll('[data-news-toggle]').forEach(function (button) {
          button.addEventListener('click', function () {
            const container = button.closest('.news');
            const expanded = button.getAttribute('aria-expanded') === 'true';
            container.querySelectorAll('.news-extra').forEach(function (row) {
              row.style.display = expanded ? 'none' : '';
            });
            button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            button.textContent = expanded ? button.dataset.more : button.dataset.less;
          });
        });
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
